# ─── Supabase ─────────────────────────────────────────────
# Copie este arquivo para .env.local e preencha com suas credenciais
# Encontre no painel do Supabase em: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Encontre em: Settings > API > service_role (manter em segredo, nunca expor no cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── App ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── IA (opcional) ────────────────────────────────────────
# Necessário para o botão ✨ IA nos blocos de proposta
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
